<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pay Bill - Bills Automation</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .pay-container {
            max-width: 600px;
            margin: 4rem auto;
            background: rgba(13, 14, 21, 0.7);
            border: 1px solid var(--border-glass);
            border-radius: 12px;
            padding: 2rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            text-align: center;
        }

        .bill-amount {
            font-size: 3rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 1rem 0;
            text-shadow: 0 0 20px rgba(255,255,255,0.1);
        }

        .bill-details {
            display: flex;
            justify-content: space-between;
            background: rgba(0,0,0,0.3);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 2rem;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .bill-detail-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .bill-detail-label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .bill-detail-value {
            font-size: 1rem;
            color: var(--text-primary);
            font-weight: 500;
        }

        .terminal-container {
            background: #08090e;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            text-align: left;
            font-family: monospace;
            font-size: 0.85rem;
            color: #a1a1aa;
            margin-bottom: 2rem;
            overflow: hidden;
        }

        .terminal-header {
            background: rgba(255,255,255,0.05);
            padding: 0.5rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .terminal-dots {
            display: flex;
            gap: 4px;
        }

        .terminal-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .dot-red { background: #ef4444; }
        .dot-yellow { background: #f59e0b; }
        .dot-green { background: #22c55e; }

        .terminal-body {
            padding: 1rem;
            height: 200px;
            overflow-y: auto;
        }

        .log-line {
            margin: 4px 0;
            line-height: 1.4;
        }

        .cmi-button {
            display: none;
            width: 100%;
            background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
            color: white;
            border: none;
            padding: 1rem;
            font-size: 1.25rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
        }

        .cmi-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(6, 182, 212, 0.6);
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,0.1);
            border-radius: 50%;
            border-top-color: #06b6d4;
            animation: spin 1s ease-in-out infinite;
            margin-right: 10px;
            vertical-align: middle;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="pay-container">
        <div style="color: var(--color-water); font-size: 2rem; margin-bottom: 0.5rem;">⚡</div>
        <h1 style="margin: 0; font-size: 1.5rem; color: var(--text-primary);">Secure Payment Gateway</h1>
        <p style="color: var(--text-secondary); margin-top: 0.5rem; margin-bottom: 2rem;">Connecting you directly to <%= provider %></p>

        <div class="bill-amount">
            <%= bill.amount %> <span style="font-size: 1.5rem; color: var(--text-secondary);">MAD</span>
        </div>

        <div class="bill-details">
            <div class="bill-detail-item">
                <span class="bill-detail-label">Provider</span>
                <span class="bill-detail-value"><%= provider %></span>
            </div>
            <div class="bill-detail-item">
                <span class="bill-detail-label">Period</span>
                <span class="bill-detail-value"><%= bill.billing_period %></span>
            </div>
            <div class="bill-detail-item">
                <span class="bill-detail-label">Due</span>
                <span class="bill-detail-value"><%= bill.due_date || 'N/A' %></span>
            </div>
        </div>

        <div class="terminal-container">
            <div class="terminal-header">
                <div class="terminal-dots">
                    <div class="terminal-dot dot-red"></div>
                    <div class="terminal-dot dot-yellow"></div>
                    <div class="terminal-dot dot-green"></div>
                </div>
                <span style="color: rgba(255,255,255,0.3); font-size: 0.75rem;">playwright-extractor.sh</span>
            </div>
            <div class="terminal-body" id="log-box">
                <div class="log-line" style="color: #06b6d4;"><span class="spinner"></span>Initializing headless browser and establishing secure connection...</div>
            </div>
        </div>

        <a id="cmi-btn" href="#" class="cmi-button">Proceed to CMI Payment ⚡</a>
        
        <div style="margin-top: 2rem;">
            <a href="/" style="color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.2s;">← Back to Dashboard</a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const provider = '<%= encodeURIComponent(provider) %>';
            const logBox = document.getElementById('log-box');
            const cmiBtn = document.getElementById('cmi-btn');
            
            const eventSource = new EventSource(`/api/stream-cmi/${provider}`);

            eventSource.onmessage = function(event) {
                try {
                    const data = JSON.parse(event.data);
                    
                    if (data.log) {
                        const line = document.createElement('div');
                        line.className = 'log-line';
                        line.textContent = data.log;
                        logBox.appendChild(line);
                        logBox.scrollTop = logBox.scrollHeight;
                    }

                    if (data.complete) {
                        eventSource.close();
                        
                        // Hide spinner on first line
                        const spinner = logBox.querySelector('.spinner');
                        if (spinner) spinner.style.display = 'none';
                        
                        if (data.url && data.url.includes('cmi.co.ma')) {
                            const successLine = document.createElement('div');
                            successLine.className = 'log-line';
                            successLine.style.color = '#22c55e';
                            successLine.style.fontWeight = 'bold';
                            successLine.style.marginTop = '10px';
                            successLine.textContent = '🚀 Link extracted successfully! Ready for payment.';
                            logBox.appendChild(successLine);
                            logBox.scrollTop = logBox.scrollHeight;
                            
                            cmiBtn.href = data.url;
                            cmiBtn.style.display = 'block';
                        } else {
                            const errorLine = document.createElement('div');
                            errorLine.className = 'log-line';
                            errorLine.style.color = '#ef4444';
                            errorLine.style.fontWeight = 'bold';
                            errorLine.textContent = '⚠️ Extraction failed. ' + (data.error || 'No CMI link returned.');
                            logBox.appendChild(errorLine);
                        }
                    }
                } catch (e) {
                    console.error('SSE parsing error', e);
                }
            };

            eventSource.onerror = function() {
                eventSource.close();
                const errorLine = document.createElement('div');
                errorLine.className = 'log-line';
                errorLine.style.color = '#ef4444';
                errorLine.textContent = '❌ Connection lost to the extraction server.';
                logBox.appendChild(errorLine);
            };
        });
    </script>
</body>
</html>
