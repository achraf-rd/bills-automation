<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paramètres - Bills Automation</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="header__left">
      <h1>⚙️ Paramètres</h1>
    </div>
    <div class="header__right">
      <a href="/" class="btn btn--outline">← Retour</a>
    </div>
  </header>

  <main class="container">
    <form class="settings-form" action="/api/settings" method="POST">
      <!-- SRM-CS -->
      <section class="settings-group settings-group--srm">
        <h3>💧⚡ SRM-CS (Eau & Électricité)</h3>
        <div class="form-grid">
          <div class="form-group">
            <label>Identifiant</label>
            <input type="text" name="srmUsername" class="form-control" value="<%= typeof settings !== 'undefined' && settings.srmUsername ? settings.srmUsername : '' %>">
          </div>

          <div class="form-group">
            <label>N° Contrat</label>
            <input type="text" name="srmContract" class="form-control" value="<%= typeof settings !== 'undefined' && settings.srmContract ? settings.srmContract : '' %>">
          </div>
        </div>
      </section>

      <!-- Inwi -->
      <section class="settings-group settings-group--inwi">
        <h3>📶 Inwi (Internet)</h3>
        <div class="form-grid">
          <div class="form-group">
            <label>Numéro de téléphone</label>
            <input type="text" name="inwiPhone" class="form-control" value="<%= typeof settings !== 'undefined' && settings.inwiPhone ? settings.inwiPhone : '' %>">
          </div>

        </div>
      </section>

      <!-- Email -->
      <section class="settings-group settings-group--email">
        <h3>📧 Configuration Email</h3>
        <div class="form-grid">
          <div class="form-group">
            <label>Serveur SMTP</label>
            <input type="text" name="smtpHost" class="form-control" value="<%= typeof settings !== 'undefined' && settings.smtpHost ? settings.smtpHost : '' %>">
          </div>
          <div class="form-group">
            <label>Port SMTP</label>
            <input type="number" name="smtpPort" class="form-control" value="<%= typeof settings !== 'undefined' && settings.smtpPort ? settings.smtpPort : '465' %>">
          </div>
          <div class="form-group">
            <label>Email Expéditeur</label>
            <input type="email" name="senderEmail" class="form-control" value="<%= typeof settings !== 'undefined' && settings.senderEmail ? settings.senderEmail : '' %>">
          </div>
          <div class="form-group">
            <label>Mot de passe App</label>
            <div class="password-wrapper">
              <input type="password" name="emailPassword" class="form-control" value="<%= typeof settings !== 'undefined' && settings.emailPassword ? settings.emailPassword : '' %>">
              <button type="button" class="password-toggle" onclick="togglePassword(this)">👁️</button>
            </div>
          </div>
          <div class="form-group">
            <label>Email Destinataire</label>
            <input type="email" name="recipientEmail" class="form-control" value="<%= typeof settings !== 'undefined' && settings.recipientEmail ? settings.recipientEmail : '' %>">
          </div>
        </div>
      </section>
      
      <!-- Planification -->
      <section class="settings-group settings-group--email">
        <h3>⏱️ Planification</h3>
        <div class="form-grid">
          <div class="form-group">
            <label>Expression Cron</label>
            <input type="text" name="cronExpression" class="form-control" value="<%= typeof settings !== 'undefined' && settings.cronExpression ? settings.cronExpression : '0 9 * * *' %>">
          </div>
          <div class="form-group" style="flex-direction: row; align-items: center; gap: 1rem; margin-top: 1.5rem;">
            <input type="checkbox" name="autoSend" id="autoSend" <%= typeof settings !== 'undefined' && settings.autoSend ? 'checked' : '' %> style="width: 20px; height: 20px;">
            <label for="autoSend" style="margin: 0; cursor: pointer;">Envoi automatique par email</label>
          </div>
        </div>
      </section>

      <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1rem;">
        <button type="submit" class="btn btn--primary" style="padding: 1rem 2rem;">💾 Enregistrer les paramètres</button>
      </div>
    </form>
  </main>

  <div id="toast-container"></div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
