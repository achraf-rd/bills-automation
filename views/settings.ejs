<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paramètres - Bills Automation</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .settings-header-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-top: 0.5rem;
      margin-bottom: 2rem;
    }
    .settings-group {
      background: rgba(15, 23, 42, 0.4);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      border: 1px solid var(--border-glass);
      transition: border-color 0.3s;
    }
    .settings-group:hover {
      border-color: rgba(255, 255, 255, 0.15);
    }
    .settings-group h3 {
      font-size: 1.25rem;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .settings-group p.desc {
      color: var(--text-secondary);
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }
    .form-group label {
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 0.4rem;
      display: block;
      font-size: 0.9rem;
    }
    .form-control {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid var(--border-glass);
      color: var(--text-primary);
      transition: all 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
    }
    .btn-save {
      background: linear-gradient(135deg, var(--color-primary), #4f46e5);
      color: white;
      padding: 1rem 2.5rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-save:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4);
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="header__left">
      <h1>⚙️ Paramètres Avancés</h1>
      <p class="settings-header-desc">Configurez vos accès fournisseurs, serveurs email et la planification automatique de vos factures.</p>
    </div>
    <div class="header__right">
      <a href="/" class="btn btn--outline" style="background: rgba(255,255,255,0.05);">← Retour au Dashboard</a>
    </div>
  </header>

  <main class="container">
    <form class="settings-form" action="/api/settings" method="POST">
      
      <!-- Lydec (Eau) -->
      <section class="settings-group" style="border-left: 4px solid var(--color-water);">
        <h3>💧 Lydec (Eau)</h3>
        <p class="desc">Vos identifiants pour l'agence en ligne Lydec (Casablanca).</p>
        <div class="form-grid">
          <div class="form-group">
            <label>Identifiant (Email ou N° Contrat)</label>
            <input type="text" name="srmUsername" class="form-control" placeholder="Ex: ly123646" value="<%= typeof settings !== 'undefined' && settings.srmUsername ? settings.srmUsername : '' %>">
          </div>
          <div class="form-group">
            <label>Mot de passe</label>
            <div class="password-wrapper">
              <input type="password" name="srmPassword" class="form-control" placeholder="••••••••" value="<%= typeof settings !== 'undefined' && settings.srmPassword ? settings.srmPassword : '' %>">
              <button type="button" class="password-toggle" onclick="togglePassword(this)">👁️</button>
            </div>
          </div>
          <div class="form-group">
            <label>N° Contrat (Optionnel)</label>
            <input type="text" name="srmContract" class="form-control" placeholder="Pour cibler un contrat précis" value="<%= typeof settings !== 'undefined' && settings.srmContract ? settings.srmContract : '' %>">
          </div>
        </div>
      </section>

      <!-- SRM (Électricité) -->
      <section class="settings-group" style="border-left: 4px solid #f59e0b;">
        <h3>⚡ SRM (Électricité)</h3>
        <p class="desc">Configuration pour l'extraction des factures d'électricité via la Société Régionale Multiservices (ex-ONEE).</p>
        <div class="form-grid">
          <div class="form-group">
            <label>Identifiant</label>
            <input type="text" name="srmElecUsername" class="form-control" placeholder="Votre identifiant" value="<%= typeof settings !== 'undefined' && settings.srmElecUsername ? settings.srmElecUsername : '' %>">
          </div>
          <div class="form-group">
            <label>Mot de passe</label>
            <div class="password-wrapper">
              <input type="password" name="srmElecPassword" class="form-control" placeholder="••••••••" value="<%= typeof settings !== 'undefined' && settings.srmElecPassword ? settings.srmElecPassword : '' %>">
              <button type="button" class="password-toggle" onclick="togglePassword(this)">👁️</button>
            </div>
          </div>
          <div class="form-group">
            <label>N° Contrat</label>
            <input type="text" name="srmElecContract" class="form-control" placeholder="N° de police" value="<%= typeof settings !== 'undefined' && settings.srmElecContract ? settings.srmElecContract : '' %>">
          </div>
        </div>
      </section>

      <!-- Inwi -->
      <section class="settings-group" style="border-left: 4px solid var(--color-internet);">
        <h3>📶 Inwi (Internet & Mobile)</h3>
        <p class="desc">Entrez le numéro de téléphone associé à votre ligne Inwi pour récupérer vos factures.</p>
        <div class="form-grid">
          <div class="form-group">
            <label>Numéro de téléphone</label>
            <input type="text" name="inwiPhone" class="form-control" placeholder="Ex: 0529875242" value="<%= typeof settings !== 'undefined' && settings.inwiPhone ? settings.inwiPhone : '' %>">
          </div>
        </div>
      </section>

      <!-- Email -->
      <section class="settings-group" style="border-left: 4px solid #10b981;">
        <h3>📧 Configuration Email & Rapports</h3>
        <p class="desc">Paramètres d'envoi SMTP et gestion des destinataires pour les rapports de facturation.</p>
        <div class="form-grid">
          <div class="form-group">
            <label>Serveur SMTP</label>
            <input type="text" name="smtpHost" class="form-control" placeholder="smtp.gmail.com" value="<%= typeof settings !== 'undefined' && settings.smtpHost ? settings.smtpHost : '' %>">
          </div>
          <div class="form-group">
            <label>Port SMTP</label>
            <input type="number" name="smtpPort" class="form-control" placeholder="465" value="<%= typeof settings !== 'undefined' && settings.smtpPort ? settings.smtpPort : '465' %>">
          </div>
          <div class="form-group">
            <label>Email Expéditeur (Identifiant SMTP)</label>
            <input type="email" name="senderEmail" class="form-control" placeholder="votre-email@gmail.com" value="<%= typeof settings !== 'undefined' && settings.senderEmail ? settings.senderEmail : '' %>">
          </div>
          <div class="form-group">
            <label>Mot de passe d'application (App Password)</label>
            <div class="password-wrapper">
              <input type="password" name="emailPassword" class="form-control" placeholder="••••••••" value="<%= typeof settings !== 'undefined' && settings.emailPassword ? settings.emailPassword : '' %>">
              <button type="button" class="password-toggle" onclick="togglePassword(this)">👁️</button>
            </div>
          </div>
          <div class="form-group" style="grid-column: 1 / -1; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem; margin-top: 0.5rem;">
            <label style="color: #6ee7b7;">Destinataire Principal (Reçoit les liens de paiement)</label>
            <input type="email" name="recipientEmail" class="form-control" placeholder="destinataire@exemple.com" value="<%= typeof settings !== 'undefined' && settings.recipientEmail ? settings.recipientEmail : '' %>">
          </div>
          <div class="form-group" style="grid-column: 1 / -1;">
            <label style="color: #93c5fd;">Destinataire Secondaire (Rapport simple, sans boutons de paiement)</label>
            <input type="email" name="reportRecipientEmail" class="form-control" placeholder="colocataire@exemple.com" value="<%= typeof settings !== 'undefined' && settings.reportRecipientEmail ? settings.reportRecipientEmail : '' %>">
          </div>
        </div>
      </section>
      
      <!-- Planification -->
      <section class="settings-group" style="border-left: 4px solid #8b5cf6;">
        <h3>⏱️ Planification (Automatisation)</h3>
        <p class="desc">Définissez quand le système doit vérifier vos factures et envoyer les emails automatiquement.</p>
        <div class="form-grid">
          <div class="form-group">
            <label>Expression Cron (Planification)</label>
            <input type="text" name="cronExpression" class="form-control" placeholder="0 9 1,16 * *" value="<%= typeof settings !== 'undefined' && settings.cronExpression ? settings.cronExpression : '0 9 1,16 * *' %>">
            <small style="color: var(--text-secondary); display: block; margin-top: 0.4rem;">Actuel : le 1er et 16 du mois à 09:00.</small>
          </div>
          <div class="form-group" style="display: flex; align-items: center; gap: 1rem; background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
            <input type="checkbox" name="autoSend" id="autoSend" <%= typeof settings !== 'undefined' && settings.autoSend === 'true' ? 'checked' : '' %> style="width: 24px; height: 24px; accent-color: #8b5cf6; cursor: pointer;">
            <label for="autoSend" style="margin: 0; cursor: pointer; font-size: 1rem;">Activer l'envoi automatique par email</label>
          </div>
        </div>
      </section>

      <div style="display: flex; justify-content: flex-end; margin-top: 2rem; margin-bottom: 4rem;">
        <button type="submit" class="btn-save">💾 Enregistrer toutes les modifications</button>
      </div>
    </form>
  </main>

  <div id="toast-container"></div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
