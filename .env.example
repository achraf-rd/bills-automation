# ==========================================
# Bills Automation — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!

# ── SRM-CS (ex-Lydec) Credentials ──
# Portal: https://client.lydec.ma
SRMCS_USERNAME=your_email_or_username
SRMCS_CONTRACT_NUMBER=your_contract_number

# ── Inwi Credentials ──
# Portal: https://myinwi.inwi.ma
INWI_PHONE_NUMBER=your_phone_number

# ── Email Configuration ──
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_RECIPIENT=recipient@example.com
EMAIL_SENDER_NAME=Bills Automation

# ── Scheduling ──
# Cron expression (default: 1st of each month at 9:00 AM)
CRON_SCHEDULE=0 9 1 * *
# Auto-send email when new bills are found
AUTO_SEND_EMAIL=false

# ── Server ──
PORT=3000

# ── Browser Automation ──
# Set to 'true' to see the browser during scraping (useful for debugging)
BROWSER_HEADLESS=true
